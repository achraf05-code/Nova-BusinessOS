# =============================================================================
# Nova BusinessOS — environment variables
# =============================================================================
# Copy to `.env.local` for local development, or paste the same keys into the
# Vercel Project Settings → Environment Variables panel.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined at build time and are safe
# to expose to the browser. All other variables are server-only and must
# never be referenced from a Client Component.
#
# When the Supabase, Stripe, or Resend variables are missing, Nova falls
# back to a fully usable demo mode (in-memory store + in-memory emails +
# fake billing). Production deployments should set every required variable.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (REQUIRED for production · Auth · Database · Storage)
# Dashboard: https://supabase.com/dashboard
# Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# App  (REQUIRED · used in absolute URLs, OG tags, email links)
# In Vercel set this to your production domain, e.g. https://app.nova-x.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nova BusinessOS


# -----------------------------------------------------------------------------
# Email — Resend  (optional in dev, REQUIRED for production)
# https://resend.com/api-keys
# Set up the sending domain + DKIM/SPF before going live.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Nova BusinessOS <hello@your-domain.com>


# -----------------------------------------------------------------------------
# Stripe  (optional in dev, REQUIRED for paid plans)
# https://dashboard.stripe.com/apikeys
# Webhook endpoint: https://YOUR_DOMAIN/api/stripe/webhook
# Subscribe to: checkout.session.completed, customer.subscription.updated,
#               customer.subscription.deleted, invoice.paid
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# AI CFO  (optional · enables LLM-augmented narrative; deterministic engine
# is used as a fallback when this key is absent)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
